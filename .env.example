# ---------------------------------------------------------------------------
# FlowBoard environment variables (example)
# Copy to .env and adjust for local development.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Auth ------------------------------------------------------------------
# REQUIRED for the Docker stack (backend runs as NODE_ENV=production).
# Generate with: openssl rand -hex 64
# In production the backend refuses to start with a weak/default secret.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- PostgreSQL -------------------------------------------------------------
# Host port 5433 is used because 5432 may be taken by another local project.
DATABASE_URL=postgresql://flowboard:flowboard@localhost:5433/flowboard?schema=public

# --- Redis -------------------------------------------------------------------
# Host port 6380 is used because 6379 may be taken by another local project.
REDIS_URL=redis://localhost:6380
# Password applied to the Redis container. Generate with: openssl rand -hex 24
REDIS_PASSWORD=change-me-to-a-long-random-secret

# --- CORS ---------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=info
